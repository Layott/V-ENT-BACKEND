# Django Core
SECRET_KEY=your-secret-key-here

# Database
DB_NAME=vent
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=3306

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Email (primary sender — used in views.py send_email)
EMAIL_ADDRESS=your-sending-email@example.com
EMAIL_PASSWORD=your-email-app-password

# Email (secondary sender — used in config.py)
COMPANY_EMAIL=your-company-email@example.com
COMPANY_EMAIL_PASSWORD=your-company-email-app-password

# Admin
ADMIN_PASSWORD=your-admin-password

# Frontend URLs
FRONTEND_URL=https://your-frontend-domain.com
FRONTEND_LOCALHOST=http://localhost:3000
