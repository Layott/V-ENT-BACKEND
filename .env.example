# Django Core
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Database
DB_NAME=vent
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=3306

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Email (primary sender — used in views.py send_email)
EMAIL_ADDRESS=your-sending-email@example.com
EMAIL_PASSWORD=your-email-app-password

# Email (secondary sender — used in config.py)
COMPANY_EMAIL=your-company-email@example.com
COMPANY_EMAIL_PASSWORD=your-company-email-app-password

# Admin
ADMIN_PASSWORD=your-admin-password

# Frontend URLs
FRONTEND_URL=https://your-frontend-domain.com
FRONTEND_LOCALHOST=http://localhost:3000

# Sign in with the African Free Fire Community (inbound SSO).
# Issued by AFC's partner console. The three URLs have working defaults from
# AFC's integration guide and only need setting if AFC moves them.
AFC_CLIENT_ID=
AFC_CLIENT_SECRET=
# AFC_AUTHORIZE_URL=
# AFC_TOKEN_URL=
# AFC_USERINFO_URL=
# AFC_SCOPE=
# Off by default. Set to 1 when AFC's own login page is working: as of
# 30 August 2026 it answers in about twelve seconds and then sits on
# "Loading...", so the button is hidden rather than leading people into it.
AFC_SSO_ENABLED=0

# ipinfo.io. Consulted before the local DB-IP file when this is set: sharper,
# especially on the mobile ranges most of V-ENT's traffic arrives on. Free tier
# is 50,000 lookups a month, and answers are cached per address for 30 days, so
# that is 50,000 DISTINCT addresses rather than 50,000 sign-ins.
#
# Leave it empty and nothing changes: a local file read, no network call, and no
# user IP leaving the server.
# IPINFO_TOKEN=
# IPINFO_TIMEOUT=2.0
